[Desktop Entry]
Name=Mixinstuff
Comment=A modern, Linux-first YouTube Music player
Exec=mixinstuff %U
Icon=io.github.matko802.Mixinstuff
Terminal=false
Type=Application
Categories=AudioVideo;Audio;Player;Music;
Keywords=youtube;music;streaming;player;audio;
StartupNotify=true
MimeType=x-scheme-handler/mixinstuff;
