# Maintainer: Mohamad Obeid <mobeid nine nine nine nine at gmail dot com>
# Contributor: Keo Ponleou Sok <dev.ponleousk@gmail.com>
pkgname=mixinstuff-git
pkgver=2026.09.12.0
pkgrel=1
pkgdesc="A modern, Linux-first YouTube Music player"
arch=('x86_64' 'aarch64')
url="https://github.com/Matko802/mixinstuff"
license=('GPL3')
# Note: webkitgtk-6.0 must come from the 'extra' repository. The CachyOS build
# is known to malfunction with Mixinstuff - see the install hook below.
depends=('gtk4' 'libadwaita' 'webkitgtk-6.0' 'openssl' 'gstreamer' 'gst-plugins-base' 'gst-plugins-good' 'gst-plugins-bad' 'sqlite' 'yt-dlp' 'yt-dlp-ejs' 'nodejs')
makedepends=('git' 'cargo')
optdepends=('ffmpeg: for downloading music')
provides=("mixinstuff")
conflicts=("mixinstuff")
install="${pkgname}.install"
# makepkg's -flto breaks the link of aws-lc-sys, the C library under rustls.
options=(!lto)
source=("${pkgname}::git+https://github.com/Matko802/mixinstuff.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  grep -oP '(?<=<release version=")[^"]+' io.github.matko802.Mixinstuff.metainfo.xml | head -1 | tr '-' '.'
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # The stylesheet and icons are compiled into the binary by build.rs. The v8
  # crate under the PO-token minter fetches its prebuilt library here.
  cargo build --frozen --release
}

package() {
  cd "$pkgname"

  install -Dm755 target/release/mixinstuff "$pkgdir/usr/bin/mixinstuff"

  install -Dm644 io.github.matko802.Mixinstuff.desktop "$pkgdir/usr/share/applications/io.github.matko802.Mixinstuff.desktop"
  install -Dm644 io.github.matko802.Mixinstuff.metainfo.xml "$pkgdir/usr/share/metainfo/io.github.matko802.Mixinstuff.metainfo.xml"
  install -Dm644 assets/icons/hicolor/scalable/apps/io.github.matko802.Mixinstuff.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.matko802.Mixinstuff.svg"
  install -Dm644 assets/icons/hicolor/symbolic/apps/io.github.matko802.Mixinstuff-symbolic.svg "$pkgdir/usr/share/icons/hicolor/symbolic/apps/io.github.matko802.Mixinstuff-symbolic.svg"
}
