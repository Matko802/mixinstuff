# Maintainer: Mohamad Obeid <mobeid nine nine nine nine at gmail dot com>
# Contributor: Keo Ponleou Sok <dev.ponleousk@gmail.com>
pkgname=musishark-git
pkgver=2026.09.12.0
pkgrel=1
pkgdesc="A modern, Linux-first YouTube Music player"
arch=('x86_64' 'aarch64')
url="https://github.com/Matko802/musishark"
license=('GPL3')
# Note: webkitgtk-6.0 must come from the 'extra' repository. The CachyOS build
# is known to malfunction with Musishark - see the install hook below.
depends=('gtk4' 'libadwaita' 'webkitgtk-6.0' 'openssl' 'gstreamer' 'gst-plugins-base' 'gst-plugins-good' 'gst-plugins-bad' 'sqlite' 'yt-dlp' 'yt-dlp-ejs' 'nodejs' 'ffmpeg')
makedepends=('git' 'cargo')
provides=("musishark")
conflicts=("musishark")
install="${pkgname}.install"
# makepkg's -flto breaks the link of aws-lc-sys, the C library under rustls.
options=(!lto)
source=("${pkgname}::git+https://github.com/Matko802/musishark.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  grep -oP '(?<=<release version=")[^"]+' io.github.matko802.Musishark.metainfo.xml | head -1 | tr '-' '.'
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # The stylesheet and icons are compiled into the binary by build.rs. The v8
  # crate under the PO-token minter fetches its prebuilt library here.
  cargo build --frozen --release
}

package() {
  cd "$pkgname"

  install -Dm755 target/release/musishark "$pkgdir/usr/bin/musishark"

  install -Dm644 io.github.matko802.Musishark.desktop "$pkgdir/usr/share/applications/io.github.matko802.Musishark.desktop"
  install -Dm644 io.github.matko802.Musishark.metainfo.xml "$pkgdir/usr/share/metainfo/io.github.matko802.Musishark.metainfo.xml"
  install -Dm644 assets/icons/hicolor/512x512/apps/io.github.matko802.Musishark.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/io.github.matko802.Musishark.png"
  install -Dm644 assets/icons/hicolor/512x512/apps/io.github.matko802.Musishark-dark.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/io.github.matko802.Musishark-dark.png"
  install -Dm644 assets/icons/hicolor/512x512/apps/io.github.matko802.Musishark-light.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/io.github.matko802.Musishark-light.png"
  install -Dm644 assets/icons/hicolor/symbolic/apps/io.github.matko802.Musishark-symbolic.svg "$pkgdir/usr/share/icons/hicolor/symbolic/apps/io.github.matko802.Musishark-symbolic.svg"
}
